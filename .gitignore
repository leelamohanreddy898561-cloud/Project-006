.env
.env.*.local
# R45 — demo tenant passwords, written by scripts/seed-demo-tenants.mjs
.demo-tenants.json

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
