    "changelog": "node scripts/generate-changelog.mjs",
    "sync:changes": "node --env-file=.env scripts/sync-changes.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "oxlint": "^1.39.0",
    "typescript": "~5.9.0",
    "vite": "^7.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  }
