rules_version = '2';

// R31 + R33 + R37 + R41 — Firestore rules.
//
// A user owns exactly one profile document. The role is fixed after creation,
// so a browser cannot promote itself to admin: only the Firebase console (or a
// future Admin SDK path) can change it. Reads, creates and deletes are limited
// to the signed-in account's own uid.
//
// R33 adds blogs: the composer at /admin/add-blog writes one document per post.
// R37 makes that collection publicly readable, because a saved post is part of
// the visitor archive; the write stays admin-only.
//
// R41 adds the tenant model. A workspace is one customer's blog:
//
//     workspaces/{workspaceId}                 public identity (name, slug, branding)
//       members/{uid}                          the team: editor or viewer
//       private/{document}                     plan and billing state — owner only
//       blogs/{blogId}                         published posts — public read, member write
//
// The owner is `workspaces/{workspaceId}.ownerUid`, not a member document, so
// there is exactly one source of truth for ownership and no role to forge. An
// editor or viewer exists only as a member document, which the owner alone can
// create, and whose role can only be "editor" or "viewer" — a member can never
// be handed ownership through the members collection.
//
// Every function takes the workspace id as a parameter. A rules function sees
// only the scope it is declared in, so reading `workspaceId` from here would
// resolve to nothing and deny everybody (the R34 defect, in Firestore form).
//
// The flat `blogs` collection stays for now: the live site reads it. R42 moves
// those documents into workspaces/signal-and-noise/blogs and retires the block.
//
// R45 adds the platform operator's authority: `users/{uid}.role == "admin"` may
// write any workspace's posts, covers, team and private state. It is an
// override, not ownership — the workspace's `ownerUid` still cannot be changed
// from the browser, a billing field is still refused on the public document,
// and a tenant's owner or editor is still confined to its own workspace.
service cloud.firestore {
  match /databases/{database}/documents {

    match /changeLog/{entry} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.role in ['student', 'user'];
      allow update: if owns(uid)
        && request.resource.data.role == resource.data.role;
      allow delete: if owns(uid);
    }

    // R37 (legacy, single tenant) — read by the live site until R42 migrates
    // these documents into a workspace. Saving a post is publishing it, so the
    // read is public and the write stays admin-only.
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // R41 — one workspace per customer blog.
    match /workspaces/{workspaceId} {

      // The public site needs the blog's name, slug and branding before anyone
      // signs in. Plan and billing state live in `private/`, not here.
      allow read: if true;

      // Self-serve onboarding creates this document from the browser: the
      // caller must be its owner, the slug must be a real slug, and no billing
      // field may be written into the public document. R45 lets the platform
      // admin create a workspace for a customer it is onboarding.
      allow create: if request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && (isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          || isAdmin())
        && isSlug(request.resource.data.slug)
        && hasNoBillingFields();

      // Ownership cannot be transferred from the browser, and a plan field
      // cannot be smuggled into the public document — not even by the platform
      // admin, whose authority is editorial and operational, not a rewrite of
      // who owns the site.
      allow update: if (isWorkspaceOwner(workspaceId) || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && hasNoBillingFields();

      allow delete: if isWorkspaceOwner(workspaceId) || isAdmin();

      // The team list is visible to the team, and to the platform admin.
      match /members/{uid} {
        allow read: if isWorkspaceMember(workspaceId) || isAdmin();
        allow create, update: if (isWorkspaceOwner(workspaceId) || isAdmin())
          && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if isWorkspaceOwner(workspaceId) || isAdmin();
      }

      // Plan, subscription and usage state. Owner and platform admin only.
      match /private/{document} {
        allow read, write: if isWorkspaceOwner(workspaceId) || isAdmin();
      }

      // Published posts of this blog: public to read, written by the owner,
      // the workspace's editors, or the platform admin (R45). A tenant's
      // account is still confined to its own workspace.
      match /blogs/{blogId} {
        allow read: if true;
        allow write: if canEditWorkspace(workspaceId) || isAdmin();
      }
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The role lives in the owner's own profile document, which the rules above
    // already let them read. A failed lookup (no document, no role, or an
    // unknown value) is not "admin".
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A workspace slug is what the public route uses, so it has one shape:
    // lower-case words joined by single hyphens.
    function isSlug(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 60
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Plan and billing state belong in private/, so the public document refuses
    // them outright rather than relying on the client to keep them out.
    function hasNoBillingFields() {
      return !request.resource.data.keys().hasAny([
        'plan',
        'planStatus',
        'stripeCustomerId',
        'stripeSubscriptionId'
      ]);
    }

    function workspaceDoc(id) {
      return /databases/$(database)/documents/workspaces/$(id);
    }

    function memberDoc(id, uid) {
      return /databases/$(database)/documents/workspaces/$(id)/members/$(uid);
    }

    function isWorkspaceOwner(id) {
      return request.auth != null
        && get(workspaceDoc(id)).data.ownerUid == request.auth.uid;
    }

    function isWorkspaceMember(id) {
      return isWorkspaceOwner(id)
        || (request.auth != null && exists(memberDoc(id, request.auth.uid)));
    }

    // Writing a blog post needs edit rights: the owner, or an editor.
    function canEditWorkspace(id) {
      return isWorkspaceOwner(id)
        || (request.auth != null
          && exists(memberDoc(id, request.auth.uid))
          && get(memberDoc(id, request.auth.uid)).data.role in ['owner', 'editor']);
    }
  }
}
