rules_version = '2';

// R31 + R33 + R37 — Firestore rules.
//
// A user owns exactly one profile document. The role is fixed after creation,
// so a browser cannot promote itself to admin: only the Firebase console (or a
// future Admin SDK path) can change it. Reads, creates and deletes are limited
// to the signed-in account's own uid.
//
// R33 adds the blogs collection: the composer at /admin/add-blog writes one
// document per post. R37 makes that collection publicly readable, because a
// saved post is part of the visitor archive; the write stays admin-only. The
// check reads the same users/{uid}.role the /admin guard reads, which means the
// page cannot grant itself the access it is protecting.
//
// The changeLog block keeps R17's existing access: its sync and read-back
// scripts run without a signed-in user. Locking it down is tracked in the known
// open items and needs those scripts to authenticate first.
service cloud.firestore {
  match /databases/{database}/documents {

    match /changeLog/{entry} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.role in ['student', 'user'];
      allow update: if owns(uid)
        && request.resource.data.role == resource.data.role;
      allow delete: if owns(uid);
    }

    // R33 + R37 — written by the admin composer, read by every visitor. The
    // collection is the published set: saving a post is publishing it, so the
    // read is public and the write stays admin-only.
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The role lives in the owner's own profile document, which the rules above
    // already let them read. A failed lookup (no document, no role, or an
    // unknown value) is not "admin".
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
